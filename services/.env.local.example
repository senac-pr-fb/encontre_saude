# Copie para services/.env.local (ignorado pelo git) e use ao rodar a função
# localmente:  npx supabase functions serve triagem --env-file .env.local
#
# Em produção esta chave NÃO fica em arquivo: vai como secret do projeto, com
#   npx supabase secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
