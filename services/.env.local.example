# Copie para services/.env.local (ignorado pelo git) e use ao rodar a função
# localmente:  npx supabase functions serve triagem --env-file .env.local
#
# Em produção estas variáveis NÃO ficam em arquivo: vão como secrets do projeto, com
#   npx supabase secrets set NOME=valor

# Qual provedor de IA responde: gemini (padrão) ou anthropic. Trocar não exige deploy.
IA_PROVEDOR=gemini

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
