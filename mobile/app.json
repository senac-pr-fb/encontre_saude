{
  "expo": {
    "name": "Encontre Saúde",
    "slug": "encontre-saude",
    "version": "1.0.0",
    "scheme": "encontresaude",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.encontresaude.app"
    },
    "android": {
      "package": "br.com.encontresaude.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
