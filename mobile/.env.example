# Copie para .env e preencha. Apenas valores PÚBLICOS entram aqui:
# tudo com prefixo EXPO_PUBLIC_ vai para o bundle do app.
# A chave do Gemini NÃO pertence a este arquivo (vive na Edge Function em services/).
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Firebase (catálogo de farmácias) — config do app web, pública por design.
# O que protege os dados são as regras do Firestore, não estas chaves.
EXPO_PUBLIC_FIREBASE_API_KEY=AIza...
EXPO_PUBLIC_FIREBASE_PROJECT_ID=encontre-saude-xxxxx
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
